# --- Datos y salidas pesadas: no van a git ---
# Se ignora el contenido de data/ y runs/, pero se conservan las carpetas
# gracias a los archivos .gitkeep (así el laboratorio clona la misma estructura).
data/**
!data/**/
!data/**/.gitkeep

runs/**
!runs/**/
!runs/**/.gitkeep

# Pesos de modelos (yolov8s.pt, best.pt, last.pt, ...)
*.pt
*.pth
*.onnx
*.engine

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Sistema y editores ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Las figuras de reports/ SI se versionan: son las de la exposicion y el
# articulo, y POP se publica con licencia CC-BY 4.0, que permite
# redistribuirlas citando la fuente (ver el README).
# Las superposiciones de WiSARD quedan fuera hasta confirmar su licencia.
reports/registro/

# Puntero local para que el asistente cargue REGLAS.md automaticamente.
# No se versiona: el archivo real del proyecto es REGLAS.md.
CLAUDE.md
